# 换行符策略
# .bat / .cmd / .ps1 必须保持 CRLF，否则 Windows cmd 会把文本片段当命令执行；
# 即使仓库被克隆到 Linux/macOS，检出时也强制还原为 CRLF。
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制类型不要做任何换行转换
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
*.xlsx binary
*.docx binary
*.doc  binary
*.whl  binary
*.so   binary
*.pyd  binary
